{
  "appId": "com.custom.teamsdesktop",
  "appName": "Teams Desktop PWA",
  "webDir": "www",
  "server": {
    "url": "https://teams.cloud.microsoft",
    "allowNavigation": [
      "://microsoft.com",
      "teams.cloud.microsoft",
      "://microsoftonline.com",
      "*.microsoft.com",
      "*.microsoftonline.com",
      "*.live.com",
      "*.mcas.ms",
      "*.microsoft",
      "*.gstatic.com",
      "*.google.com",
      "*.gvt2.com",
      "*.office.net",
      "*.msftauth.net",
      "*.googleapis.com",
      "*.msftauthimages.net",
      "*.cloud.microsoft",
      "*.office.com",
      "*.office365.com",
      "*.microsoft365.com",
      "*.msauth.net",
      "*.microsoftonline-p.com",
      "*.sharepoint.com",
      "*.skype.com",
      "*.cas.ms",
      "*.admin-mcas.ms"
    ]
  },
  "android": {
    "backgroundColor": "#1f1f1f"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#1f1f1f"
    }
  }
}
